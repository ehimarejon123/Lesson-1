import tkinter as tk
import random

def play_game(user_choice):
    choices = ["Rock", "Paper", "Scissors"]
    program_choice = random.choice(choices)
    
    player_choice_label.config(text=f"Player: {user_choice}")
    program_choice_label.config(text=f"Program: {program_choice}")
    
    if user_choice == program_choice:
        result = "It's a Tie!"
    elif (user_choice == "Rock" and program_choice == "Scissors") or \
         (user_choice == "Paper" and program_choice == "Rock") or \
         (user_choice == "Scissors" and program_choice == "Paper"):
        result = "Player Wins!"
    else:
        result = "Program Wins!"
        
    winner_label.config(text=result)

def reset_game():
    player_choice_label.config(text="Player: -")
    program_choice_label.config(text="Program: -")
    winner_label.config(text="Choose a move to start!")

root = tk.Tk()
root.title("Rock Paper Scissors")
root.geometry("400x300")

title_label = tk.Label(root, text="Rock Paper Scissors", font=("Arial", 16, "bold"))
title_label.pack(pady=10)

button_frame = tk.Frame(root)
button_frame.pack(pady=10)

rock_btn = tk.Button(button_frame, text="Rock", width=10, command=lambda: play_game("Rock"))
rock_btn.grid(row=0, column=0, padx=5)

paper_btn = tk.Button(button_frame, text="Paper", width=10, command=lambda: play_game("Paper"))
paper_btn.grid(row=0, column=1, padx=5)

scissor_btn = tk.Button(button_frame, text="Scissors", width=10, command=lambda: play_game("Scissors"))
scissor_btn.grid(row=0, column=2, padx=5)

display_frame = tk.Frame(root)
display_frame.pack(pady=15)

player_choice_label = tk.Label(display_frame, text="Player: -", font=("Arial", 12))
player_choice_label.grid(row=0, column=0, padx=20)

program_choice_label = tk.Label(display_frame, text="Program: -", font=("Arial", 12))
program_choice_label.grid(row=0, column=1, padx=20)

winner_label = tk.Label(root, text="Choose a move to start!", font=("Arial", 14, "bold"), fg="blue")
winner_label.pack(pady=10)

reset_btn = tk.Button(root, text="Reset / Restart", command=reset_game, bg="lightgray")
reset_btn.pack(pady=10)

root.mainloop()