import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
df = sns.load_dataset('penguins')
print("First 5 rows:")
print(df.head())
print("\nLast 5 rows:")
print(df.tail())
print("\nDataset Shape:", df.shape)
print(df.dtypes)
print("\nDataset Info: ")
print(df.info())
print("\nMissinf Values per Column")
print(df.isnull().sum())
df = df.dropna()
print("\nSummary Statistics (All Columns)")
print(df.describe(include='all'))
subset_df = df.iloc[41:76]
print("\nSubset (Rows 41 to 75):")
print(subset_df)
max_mass_idx = np.argmax(df['body_mass_g'].values)
heaviest_penguin = df.iloc[[max_mass_idx]]
print("\nPenguin with Highest Body Mass:")
print(heaviest_penguin)
mass_arr = df['body_mass_g'].values
flipper_arr = df['flipper_length_mm'].values
print("\nNumPy Summary Statistics:")
print("Mean Body Mass (g):", np.round(np.mean(mass_arr), 2))
print("Median Flipper Length (mm):", np.median(flipper_arr))
print("Standard Deviation of Body Mass (g):", np.round(np.std(mass_arr), 2))
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
sns.boxplot(y=df['body_mass_g'], color='skyblue')
plt.title('Boxplot of Body Mass (g)')
plt.subplot(1, 2, 2)
sns.boxplot(y=df['flipper_length_mm'], color='lightgreen')
plt.title('Boxplot of Flipper Length (mm)')
plt.tight_layout()
plt.show()
plt.figure(figsize=(8, 5))
plt.scatter(df['flipper_length_mm'], df['body_mass_g'], alpha=0.6, color='coral', label='Penguins')
slope, intercept = np.polyfit(df['flipper_length_mm'], df['body_mass_g'], 1)
plt.plot(df['flipper_length_mm'], slope * df['flipper_length_mm'] + intercept, color='darkred', linestyle='--', label='Trendline')
plt.title('Relationship Between Flipper Length and Body Mass')
plt.xlabel('Flipper Length (mm)')
plt.ylabel('Body Mass (g)')
plt.legend()
plt.show()
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
sns.histplot(df['body_mass_g'], kde=True, color='purple')
plt.title('Distribution of Body Mass (g)')
plt.subplot(1, 2, 2)
sns.histplot(df['flipper_length_mm'], kde=True, color='orange')
plt.title('Distribution of Flipper Length (mm)')
plt.tight_layout()
plt.show()
plt.figure(figsize=(8, 5))
sns.countplot(data=df, x='species', palette='viridis')
plt.title('Number of Penguins by Species')
plt.xlabel('Species')
plt.ylabel('Count')
plt.show()
plt.figure(figsize=(6, 4))
numeric_cols = df.select_dtypes(include=[np.number])
sns.heatmap(numeric_cols.corr(), annot=True, cmap='coolwarm', fmt='.2f')
plt.title('Correlation Heatmap')
plt.show()