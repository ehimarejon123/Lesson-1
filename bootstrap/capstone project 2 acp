SELECT 
    c.customer_id,
    c.customer_name,
    p.product_name,
    p.category,
    e.export_country
FROM 
    customers c
JOIN 
    orders o ON c.customer_id = o.customer_id
JOIN 
    products p ON o.product_id = p.product_id
JOIN 
    exports e ON o.order_id = e.order_id
WHERE 
    c.customer_name LIKE 'a%' 
    AND c.customer_name LIKE '%or%';
